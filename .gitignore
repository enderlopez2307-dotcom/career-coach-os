# Your job search is private. Nothing below is ever committed by default, so a
# commit and push from this folder cannot publish it.

# Your real config files (the *.template.* files ARE committed)
config/*.md
!config/*.template.md
config/*.json
!config/*.template.json

# Everything in the vault except the empty-folder markers and the story template
vault/**
!vault/**/
!vault/**/.gitkeep
!vault/Stories/_Story Template.md

# Runtime and machine files
logs/
state/
.claude/settings.local.json
.DS_Store

# Marks this folder as a previous export
.careercoachos-public-export
